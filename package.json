{
  "name": "inventory-reservation-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-db.ts",
    "demo:local": "sh scripts/with-local-postgres.sh sh -c 'npm run db:setup && SESSION_COOKIE_SECURE=false npm run dev'",
    "test": "sh scripts/with-local-postgres.sh",
    "test:e2e": "sh scripts/with-local-postgres.sh sh -c 'npm run db:setup && playwright test'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ioredis": "6.0.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
